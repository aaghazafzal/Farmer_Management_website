# ─────────────────────────────────────────────────────
#  KisanSetu Backend — Environment Configuration
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
APP_VERSION=1.0.0

# ── MongoDB ────────────────────────────────────────────
# For local MongoDB:
#   DATABASE_URL=mongodb://localhost:27017
# For MongoDB Atlas:
#   DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=kisansetu

# ── Firebase Admin SDK ─────────────────────────────────
# Download the service account JSON from:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
#
# Option 1 — Path to downloaded JSON file (recommended for local dev):
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.json
#
# Option 2 — Individual fields (for production/env injection):
FIREBASE_PROJECT_ID=kisansetu-a1cad
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Google Maps API ────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Firebase Web Credentials (for secure key delivery to frontend) ──
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=kisansetu-a1cad.firebaseapp.com
FIREBASE_STORAGE_BUCKET=kisansetu-a1cad.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── CORS ───────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# For local development:
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
# For production, add your deployed domain:
# FRONTEND_ORIGINS=https://kisansetu.in,https://admin.kisansetu.in

# ── Rate Limiting ──────────────────────────────────────
# Auth endpoints (signup/login/OTP): max requests per minute per IP
AUTH_RATE_LIMIT=5/minute
# General API: max requests per minute per IP
API_RATE_LIMIT=60/minute
# Booking creation: max per minute per IP
BOOKING_RATE_LIMIT=10/minute
# Alert creation: max per hour per IP
ALERT_RATE_LIMIT=20/hour

# ── Queue Operations ───────────────────────────────────
# Default average processing time per farmer (minutes)
DEFAULT_PROCESSING_MINUTES=12
# IST timezone offset for display
APP_TIMEZONE=Asia/Kolkata
